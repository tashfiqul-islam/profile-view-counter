{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "*.config.ts",
      "package.json",
      "tsconfig.json",
      "renovate.json",
      "biome.jsonc",
      "wrangler.jsonc",
      ".releaserc.json",
      "!!**/.claude-flow",
      "!!**/.mcp.json"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      }
    }
  }
}
