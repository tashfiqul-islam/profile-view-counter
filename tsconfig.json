{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The Worker and its tests: workerd bindings from `wrangler types` plus the Vitest plugin types.
  // No Bun or Node globals here, so runtime-only APIs cannot slip into src/.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo-worker",
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
