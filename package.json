{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "profile-view-counter",
  "private": true,
  "description": "A profile view counter badge for GitHub READMEs, served by a Cloudflare Worker",
  "keywords": [
    "badge",
    "cloudflare-workers",
    "counter",
    "github",
    "hono",
    "profile-views",
    "typescript"
  ],
  "homepage": "https://github.com/tashfiqul-islam/profile-view-counter#readme",
  "bugs": "https://github.com/tashfiqul-islam/profile-view-counter/issues",
  "license": "MIT",
  "author": "Tashfiqul Islam (https://github.com/tashfiqul-islam)",
  "repository": "github:tashfiqul-islam/profile-view-counter",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run docs:check && bun run test",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:check": "bun scripts/agent-docs.ts",
    "badge:gallery": "bun scripts/badge-gallery.ts",
    "readme:art": "bun scripts/readme-art.ts",
    "test": "bun run test:worker && bun run test:scripts",
    "test:worker": "vitest run --coverage",
    "test:scripts": "bun test",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/valibot-validator": "0.6.2",
    "hono": "4.13.19",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@semantic-release/github": "12.0.11",
    "@types/bun": "1.4.4",
    "@vitest/coverage-istanbul": "5.1.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint-plugin-jsdoc": "65.4.11",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.164.0"
  }
}
