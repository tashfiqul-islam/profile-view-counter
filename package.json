{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "profile-view-counter",
  "version": "2.1.5",
  "type": "module",
  "description": "A blazing-fast profile view counter for GitHub READMEs, powered by Cloudflare Workers",
  "author": {
    "name": "Tashfiqul Islam",
    "url": "https://github.com/tashfiqul-islam"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tashfiqul-islam/profile-view-counter.git"
  },
  "homepage": "https://github.com/tashfiqul-islam/profile-view-counter#readme",
  "bugs": {
    "url": "https://github.com/tashfiqul-islam/profile-view-counter/issues"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "sideEffects": false,
  "keywords": [
    "cloudflare-workers",
    "profile-views",
    "github",
    "badge",
    "counter",
    "hono",
    "typescript"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "bun test test/badge-generator.test.ts && bunx vitest run",
    "test:unit": "bun test test/badge-generator.test.ts",
    "test:integration": "bunx vitest run",
    "test:watch": "bunx vitest",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types",
    "prepare": "lefthook install",
    "commit": "bunx czg"
  },
  "dependencies": {
    "@hono/valibot-validator": "0.6.1",
    "hono": "4.12.12",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@cloudflare/vitest-pool-workers": "0.14.3",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@commitlint/types": "20.5.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@types/bun": "1.3.11",
    "@vitest/coverage-istanbul": "4.1.4",
    "czg": "1.12.0",
    "lefthook": "2.1.5",
    "picocolors": "1.1.1",
    "semantic-release": "25.0.3",
    "typescript": "6.0.2",
    "ultracite": "7.4.4",
    "vitest": "4.1.4",
    "wrangler": "4.81.1"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ],
  "config": {
    "commitizen": {
      "path": "node_modules/czg",
      "$schema": "https://raw.githubusercontent.com/Zhengqbbb/cz-git/main/docs/public/schema/cz-git.json"
    }
  }
}
