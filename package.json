{
  "name": "profile-view-counter",
  "version": "2.0.1",
  "type": "module",
  "description": "A blazing-fast profile view counter for GitHub READMEs, powered by Cloudflare Workers",
  "author": "Tashfiqul Islam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tashfiqul-islam/profile-view-counter"
  },
  "packageManager": "bun@1.3.10",
  "keywords": [
    "cloudflare-workers",
    "profile-views",
    "github",
    "badge",
    "counter",
    "hono",
    "typescript"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "bun test test/badge-generator.test.ts && bunx vitest run",
    "test:unit": "bun test test/badge-generator.test.ts",
    "test:integration": "bunx vitest run",
    "test:watch": "bunx vitest",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@hono/valibot-validator": "0.6.1",
    "hono": "4.12.3",
    "valibot": "1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@cloudflare/vitest-pool-workers": "0.12.18",
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@commitlint/types": "20.4.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@types/bun": "1.3.9",
    "@vitest/coverage-istanbul": "3.2.4",
    "commitizen": "4.3.1",
    "cz-git": "1.12.0",
    "lefthook": "2.1.1",
    "semantic-release": "25.0.3",
    "typescript": "5.9.3",
    "ultracite": "7.2.4",
    "vitest": "3.2.4",
    "wrangler": "4.69.0"
  }
}
