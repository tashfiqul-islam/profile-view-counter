{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)"
  ],
  "timezone": "Asia/Dhaka",
  "schedule": ["after 2am and before 4am on monday"],
  "labels": ["dependencies"],
  "assignees": ["tashfiqul-islam"],
  "dependencyDashboard": { "enabled": true, "title": "🔄 Dependency Dashboard" },
  "minimumReleaseAge": "3 days",
  "automergeType": "pr",
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 3am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "hk config package version in hk.pkl (tracks the hk binary in mise.toml)",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": [
        "hk/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+"
      ],
      "autoReplaceStringTemplate": "hk/releases/download/v{{newValue}}/hk@{{newValue}}",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/hk",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Pinned Renovate CLI used by the config validator workflow",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": ["renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge everything except majors once CI is green",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Majors wait for approval on the dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "breaking-change"]
    },
    {
      "description": "Hold the conventionalcommits preset at v8: v9+ renders empty release notes with the writer bundled in semantic-release",
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "<9"
    },
    {
      "description": "wrangler and the Vitest plugin share one miniflare build; update them together",
      "matchPackageNames": ["wrangler", "/^@cloudflare//"],
      "groupName": "cloudflare"
    },
    {
      "matchPackageNames": ["vitest", "/^@vitest//"],
      "groupName": "vitest"
    },
    {
      "matchPackageNames": ["hono", "/^@hono//"],
      "groupName": "hono"
    },
    {
      "matchPackageNames": ["oxlint", "oxfmt", "oxlint-tsgolint"],
      "groupName": "oxc"
    },
    {
      "matchPackageNames": ["semantic-release", "/^@semantic-release//"],
      "groupName": "semantic-release"
    },
    {
      "matchPackageNames": ["/^@commitlint//"],
      "groupName": "commitlint"
    },
    {
      "description": "Dev dependencies never change the deployed Worker, so they release nothing",
      "matchDepTypes": ["devDependencies"],
      "semanticCommitScope": "tooling"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitScope": "actions"
    },
    {
      "description": "Dev toolchain: mise tools, hk config, Renovate CLI",
      "matchManagers": ["mise", "custom.regex"],
      "groupName": "toolchain",
      "semanticCommitScope": "tooling"
    },
    {
      "description": "Bun runtime and its types move together (last rule wins over the toolchain group)",
      "matchPackageNames": ["bun", "@types/bun"],
      "groupName": "bun",
      "semanticCommitScope": "bun"
    }
  ]
}
